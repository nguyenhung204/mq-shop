# Test-only values for the throwaway E2E stack (temp containers on odd ports). No real secrets.
NODE_ENV=development
PORT=3005
DATABASE_URL=postgres://e2e:e2e_pw_local@localhost:55432/mq_e2e
REDIS_URL=redis://localhost:56379
JWT_ACCESS_SECRET=e2e-access-secret-not-for-production-0123456789
JWT_ACCESS_TTL_SECONDS=86400
TRUST_PROXY=1
JWT_REFRESH_SECRET=e2e-refresh-secret-not-for-production-0123456789
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
OTP_LOG_PLAINTEXT=1
COOKIE_SECURE=false
ENABLE_SWAGGER=true
TYPEORM_SYNC=true
LOG_LEVEL=info
MAIL_PROVIDER=noop
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:59010
S3_ACCESS_KEY=e2eminio
S3_SECRET_KEY=e2eminio_pw
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_BUCKET=mq-e2e
STORAGE_PUBLIC_URL=http://localhost:59010/mq-e2e
BACKUP_DAILY_ENABLED=false

# commission rows are credited to the wallet immediately (default is HOLD=true => PENDING, wallet untouched); needed by 08-partial-refund
COMMISSION_PAYOUT_HOLD=false
