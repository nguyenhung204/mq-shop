# Backend API host (no trailing slash). Socket.IO uses the same host.
NEXT_PUBLIC_API_HOST=http://localhost:3000

# Docker image to pull (used by docker-compose.prod.yml)
DOCKERHUB_IMAGE=trantuanhung1209/mq-shop:latest

# Host port mapped to the container's 3000 (used by docker-compose)
APP_PORT=3001

# Runtime environment
NODE_ENV=production
